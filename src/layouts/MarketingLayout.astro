---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingContact from "../components/FloatingContact.jsx";
import "../index.css";

export interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image,
  noindex = false,
} = Astro.props;

const siteUrl = "https://klair.ca";
const canonicalUrl = new URL(path, siteUrl).toString();
const ogImage = image
  ? new URL(image, siteUrl).toString()
  : `${siteUrl}/images/klair-logo-share.png`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Klair Computer",
  "url": siteUrl,
  "image": `${siteUrl}/images/klair-logo-share.png`,
  "telephone": "+1-780-265-0042",
  "email": "info@klair.ca",
  "areaServed": [
    { "@type": "City", "name": "Edmonton", "containedInPlace": { "@type": "State", "name": "Alberta" } },
    { "@type": "City", "name": "Leduc", "containedInPlace": { "@type": "State", "name": "Alberta" } },
    { "@type": "City", "name": "Nisku", "containedInPlace": { "@type": "State", "name": "Alberta" } },
    { "@type": "City", "name": "St. Albert", "containedInPlace": { "@type": "State", "name": "Alberta" } },
    { "@type": "City", "name": "Sherwood Park", "containedInPlace": { "@type": "State", "name": "Alberta" } },
    { "@type": "City", "name": "Spruce Grove", "containedInPlace": { "@type": "State", "name": "Alberta" } },
    { "@type": "City", "name": "Fort Saskatchewan", "containedInPlace": { "@type": "State", "name": "Alberta" } }
  ],
  "description": "Managed IT support, cybersecurity, and cloud solutions for businesses across the Edmonton region, with weekend on-call support available.",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link 
      rel="preload" 
      href="/fonts/DM-Sans-400.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin
    />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title} | Klair Computer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Klair Computer`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Klair Computer`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContact client:load />
  </body>
</html>